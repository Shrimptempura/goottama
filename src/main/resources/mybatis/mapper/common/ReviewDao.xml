<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.ama.don.common.dao.ReviewDao">

    <!-- 다형성 리뷰만 사용시 -->
    <!-- 공통리뷰(userId, targetId, targetType, review_content) -->
    <insert id="insertPolyReview"
            parameterType="com.ama.don.common.dto.ReviewDto"
            useGeneratedKeys="true"
            keyProperty="reviewId">
        insert into review (user_id, target_id, target_type, review_content)
        values (
            #{userId}, #{targetId}, #{targetType}, #{reviewContent})
    </insert>

    <!-- 공통 리뷰를 그대로 사용하여 작성, 파일은 여러장 이므로 따로 생성 -->
    <insert id="insertCommonReview"
            parameterType="com.ama.don.common.dto.ReviewDto"
            useGeneratedKeys="true"
            keyProperty="reviewId">
        insert into review (user_id, review_title, review_content, review_count,
            review_date, review_modify, target_id, target_type)
        values (
            #{userId}, #{reviewTitle}, #{reviewContent}, #{reviewCount},
            #{reviewDate}, #{reviewModify}, #{targetId}, #{targetType})
    </insert>

    <!-- default 조회 -->
    <select id="selectById" resultType="com.ama.don.common.dto.ReviewDto">
        select review_id AS reviewId, review_date AS reviewDate, review_modify AS reviewModify
        from review
        where review_id = #{reviewId}
    </select>

    <!--    &lt;!&ndash; 파일만 저장 여러장 &ndash;&gt;
        <insert id="insertReviewFile"
                parameterType="com.ama.don.common.dto.FileDto"
                useGeneratedKeys="true"
                keyProperty="fileId">
            insert into file (
                file_uploader, file_name, file_path, target_type, target_id)
            values (
                #{fileUploader}, #{fileName}, #{filePath}, #{targetType}, #{targetId}
            )
        </insert>-->


</mapper>