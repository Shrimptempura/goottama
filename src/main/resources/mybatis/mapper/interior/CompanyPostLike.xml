<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.ama.don.interior.dao.CompanyPostLikeDao">

    <!-- 회원과 게시글 좋아요 여부 확인 -->
    <select id="isLikedCompanyPost" resultType="java.lang.Boolean">
        SELECT EXISTS (
            SELECT 1
            FROM company_post_like
            WHERE company_post_id = #{companyPostId}
                AND user_id = #{userId}
        ) AS isLiked;
    </select>

    <insert id="insertLikeCompanyPost"
            parameterType="com.ama.don.interior.dto.response.CompanyPostLikeDto"
            useGeneratedKeys="true"
            keyProperty="companyPostLikeId">
        INSERT INTO company_post_like (
            company_post_id,
            user_id)
        VALUES (
            #{companyPostId},
            #{userId}
        )
    </insert>

</mapper>