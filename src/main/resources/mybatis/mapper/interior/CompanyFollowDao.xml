<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.ama.don.interior.dao.CompanyFollowDao">

    <select id="isFollowedCompany" resultType="java.lang.Boolean">
        select count(*) > 0
        from company_follow
        where company_id = #{companyId}
        and user_id = #{userId}
    </select>

</mapper>