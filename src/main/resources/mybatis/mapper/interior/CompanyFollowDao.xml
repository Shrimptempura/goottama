<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.ama.don.interior.dao.CompanyFollowDao">

    <!--  회원이 업체 팔로우 생성  -->
    <insert id="insertFollowCompany"
            parameterType="com.ama.don.interior.dto.request.CompanyFollowDto"
            useGeneratedKeys="true"
            keyProperty="followId">
        insert into company_follow (
            company_id, user_id, follow_at)
        values (
            #{companyId}, #{userId}, now()
        )
    </insert>

    <delete id="deleteFollowCompany">

    </delete>

    <select id="isFollowedCompany" resultType="java.lang.Boolean">
        select count(*) > 0
        from company_follow
        where company_id = #{companyId}
        and user_id = #{userId}
    </select>

</mapper>