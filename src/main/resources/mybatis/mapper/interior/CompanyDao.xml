<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.ama.don.interior.dao.CompanyDao">

    <!--  회원 예제  -->
    <insert id="insertUser" parameterType="com.ama.don.member.dto.JoinformDto" useGeneratedKeys="true" keyProperty="userId">
        INSERT INTO user_detail(USER_NAME,USER_NICKNAME,USER_GENDER,USER_BIRTH,USER_TEL,USER_ZIPCODE,USER_ADDR,USER_EMAIL)
        VALUES(#{name},#{nickname},#{gender},#{birth},#{tel},#{zipcode},#{fullAddr},#{email})
    </insert>


    <!--  company_detail 생성  -->
    <insert id="insertCompanyDetail"
            parameterType="com.ama.don.interior.dto.request.CompanyCreateDto"
            useGeneratedKeys="true"
            keyProperty="companyDetailId">
        insert into company_detail (
            company_name, company_addr, company_field, company_license, company_as,
            company_career, company_intro)
        values (
            #{companyName}, #{companyAddr}, #{companyField}, #{companyLicense}, #{companyAs},
            #{companyCareer}, #{companyIntro}
        );
    </insert>

    <!--  location 테이블  -->
    <!--  일단 주소만 적고 나머지는 추후 계산  -->
    <insert id="insertLocation"
            parameterType="com.ama.don.interior.dto.request.CompanyCreateLocationDto"
            useGeneratedKeys="true"
            keyProperty="locationId">
        insert into location (
            location_addr)
        values (
            #{locationAddr}
        );
    </insert>

    <insert id="insertCompany"
            parameterType="com.ama.don.interior.dto.request.CompanyInsertDto"
            useGeneratedKeys="true"
            keyProperty="companyId">
        insert into company (
            user_id, company_detail_id, location_id, company_img
        )
        values (
            #{userId}, #{companyDetailId}, #{locationId}, #{companyImg}
        );
    </insert>


    <update id="updateCompany">

    </update>

    <delete id="deleteCompany">

    </delete>

    <select id="isDuplicateCompanyName" resultType="java.lang.Boolean">

    </select>

    <select id="selectDetailCompany" resultType="com.ama.don.interior.dto.response.CompanyDetailDto">

    </select>

    <select id="selectSummaryCompany" resultType="com.ama.don.interior.dto.response.CompanySummaryDto">

    </select>

    <select id="findCompanyIdByUserId" resultType="java.lang.Long">

    </select>
</mapper>