<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.ama.don.community.dao.Detail_viewDao">

	<!-- 게시글 상세 조회 (이미지 포함) -->
	<select id="selectReviewById" resultMap="ReviewWithImagesMap">
		SELECT
		p.*,
		f.file_id AS f_file_id,
		f.file_name AS f_file_name,
		f.file_path AS f_file_path,
		f.target_type AS f_target_type,
		f.target_id AS f_target_id
		FROM post p
		LEFT JOIN file f
		ON f.target_id = p.post_id
		AND f.target_type IN ('COMMUNITY_REVIEW', 'COMMUNITY_HOUSEPHOTO',
		'COMMUNITY_HOUSEDECORATION')
		WHERE p.post_id = #{post_id}
	</select>


	<!-- 게시글 수정 -->
	<update id="updateReview"
		parameterType="com.ama.don.community.dto.Detail_viewDto">
		UPDATE post
		SET
		post_title = #{post_title},
		post_content =
		#{post_content}
		WHERE post_id = #{post_id}
	</update>

	<!-- 게시글 삭제 -->
	<delete id="deleteReview"
		parameterType="com.ama.don.community.dto.Detail_viewDto">
		DELETE FROM post
		WHERE post_id = #{post_id}
	</delete>

	<!-- 이미지 포함한 결과 매핑 -->
	<resultMap id="ReviewWithImagesMap"
		type="com.ama.don.community.dto.Detail_viewDto">
		<id property="post_id" column="post_id" />
		<result property="user_id" column="user_id" />
		<result property="post_title" column="post_title" />
		<result property="post_content" column="post_content" />
		<result property="post_date" column="post_date" />
		<result property="post_count" column="post_count" />
		<result property="post_like_count" column="post_like_count" />
		<result property="post_img" column="post_img" />
		<result property="target_type" column="target_type" />
		<result property="target_id" column="target_id" />

		<collection property="post_images"
			ofType="com.ama.don.common.dto.FileDto">
			<id property="file_id" column="f_file_id" />
			<result property="file_name" column="f_file_name" />
			<result property="file_path" column="f_file_path" />
			<result property="target_type" column="f_target_type" />
			<result property="target_id" column="f_target_id" />
		</collection>
	</resultMap>

</mapper>
