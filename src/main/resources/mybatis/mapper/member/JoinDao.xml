<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "https://.org/dtdmybatis/mybatis-3-mapper.dtd">

<mapper namespace="com.ama.don.member.dao.JoinDao">

	<select id="checkId">
	SELECT COUNT(*) FROM user_login WHERE LOGIN_ID=#{param1}
	</select> 
	
	<insert id="insertUserDtail">
	INSERT INTO user_detail(USER_NAME,USER_NICKNAME,USER_GENDER,USER_BIRTH,USER_TEL,USER_ZIPCODE,USER_ADDR,USER_EMAIL)
	VALUES(#{param1},#{param2},#{param3},#{param4},#{param5},#{param6},#{param7},#{param8})
	</insert>
	
	<select id="selectMaxUserId" resultType="long">
	SELECT MAX(USER_ID) FROM user_detail
	</select> 
	
	<insert id="insertUserLogin">
	INSERT INTO user_login(LOGIN_ID,USER_ID,ROLES_ID,USER_PASSWORD) VALUES(#{param2},#{param1},#{param4},#{param3})
	</insert>

</mapper>