<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "https://.org/dtdmybatis/mybatis-3-mapper.dtd">

<mapper namespace="com.ama.don.member.dao.JoinDao">

	<select id="checkId" resultType="int">
	SELECT COUNT(*) FROM user_login WHERE LOGIN_ID=#{loginId}
	</select> 
	
	<select id="checkNickname" resultType="int">
	SELECT COUNT(*) FROM user_detail WHERE USER_NICKNAME=#{nickname}
	</select> 
	
	<select id="checkEmail" resultType="int">
	SELECT COUNT(*) FROM user_detail WHERE USER_EMAIL=#{email}
	</select> 
	
	<insert id="insertUserDtail" parameterType="com.ama.don.member.dto.JoinformDto" useGeneratedKeys="true" keyProperty="userId">
	INSERT INTO user_detail(USER_NAME,USER_NICKNAME,USER_GENDER,USER_BIRTH,USER_TEL,USER_ZIPCODE,USER_ADDR,USER_EMAIL)
	VALUES(#{name},#{nickname},#{gender},#{birth},#{tel},#{zipcode},#{fullAddr},#{email})
	</insert>
	
	<insert id="insertUserLogin">
	INSERT INTO user_login(LOGIN_ID,USER_ID,ROLES_ID,USER_PASSWORD) VALUES(#{loginId},#{userId},#{rolesId},#{pw})
	</insert>


</mapper>