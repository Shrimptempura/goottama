<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "https://.org/dtdmybatis/mybatis-3-mapper.dtd">

<mapper namespace="com.ama.don.member.dao.WithdrawalDao">

	<update id="changeMemberStatus">
	update user_detail set user_status = 'deleted' where user_id = #{user_id}
	</update>
	
	<insert id="insertWithdrawalMember">
	insert into withdrawal_member(withdrawal_reason_id,user_id) values(#{reason},#{user_id})
	</insert>

</mapper>